# Sao chép file này thành ".env" (không commit "./.env" lên git) rồi điền thông tin bên dưới
# để "npm run sync-wifi-unifi" lấy tên WiFi + kênh sóng trực tiếp từ UniFi Controller.

# Tạo tại: unifi.ui.com > góc trên bên phải > Account Settings > API
# (nên tạo key chỉ có quyền đọc/View nếu UniFi cho chọn phạm vi quyền).
UNIFI_API_KEY=

# Lấy từ URL trang quản lý console, ví dụ:
# https://unifi.ui.com/network-servers/d8806959-2de8-452a-9a3a-445c993eb57a:1706650165/network/default/devices
#                                       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ (phần trước dấu ":")
# Nếu để mặc định mà script báo lỗi 404, thử điền cả phần sau dấu ":" luôn, ví dụ:
# d8806959-2de8-452a-9a3a-445c993eb57a:1706650165
UNIFI_CONSOLE_ID=d8806959-2de8-452a-9a3a-445c993eb57a

# Lấy từ URL, phần sau "/network/" (thường là "default")
UNIFI_SITE_ID=default
